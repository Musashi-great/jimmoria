{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimmoria.local/schemas/signal.schema.json",
  "title": "JIMMORIA Public Signal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "observed_at",
    "source_type",
    "source_url",
    "raw_signal",
    "project_guess",
    "suggested_action",
    "confidence",
    "source_ids"
  ],
  "properties": {
    "signal_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "source_type": {
      "type": "string",
      "enum": ["X", "rss", "web", "docs", "github", "dex", "rootdata", "coingecko", "defillama", "explorer", "rpc", "manual_public_source"]
    },
    "source_url": {"type": "string"},
    "raw_signal": {"type": "string"},
    "project_guess": {"type": "string"},
    "narrative_hint": {"type": "string"},
    "dedupe_key": {"type": "string"},
    "priority": {"type": "string", "enum": ["low", "medium", "high", "urgent"]},
    "suggested_action": {
      "type": "string",
      "enum": ["research_room", "watchlist", "archive", "identity_conflict", "already_late", "red_flag"]
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
